struct D9LevelRead{AxisScene scene;AcGePoint3d apex;std::wstring caption;double value{};std::vector<AcGePoint3d> grips,stretch;};
double d9_value(std::wstring textValue){if(textValue.rfind(L"%%P",0)==0||textValue.rfind(L"%%p",0)==0)textValue=textValue.substr(3);else if(!textValue.empty()&&textValue[0]==L'±')textValue=textValue.substr(1);if(!textValue.empty()&&textValue[0]==L'−')textValue[0]=L'-';wchar_t* end{};const double n=std::wcstod(textValue.c_str(),&end);require(end==textValue.c_str()+textValue.size()&&end!=textValue.c_str()&&std::isfinite(n),"D9 actual native level caption is not numeric");return n;}
D9LevelRead d9_read_level(AcDbObjectId id){Working scope(id.database());auto e=opened<AcDbEntity>(id);require(std::wstring(e->isA()->name())==L"TDbSymbElevation"&&!e->isAProxy(),"D9 level must remain genuine TDbSymbElevation");D9LevelRead r;read_axis(*e,r.scene);require((r.scene.lines.size()==3||r.scene.lines.size()==4)&&r.scene.texts.size()==1&&r.scene.visible,"D9 actual level public geometry differs");r.apex=r.scene.lines[0].first;require(r.apex.distanceTo(r.scene.lines[1].first)<tolerance,"D9 actual elevation apex mismatch");r.caption=r.scene.texts[0].text;r.value=d9_value(r.caption);AcGePoint3dArray gp;AcDbIntArray a,b;check(e->getGripPoints(gp,a,b),"D9 actual level legacy grips");for(int i=0;i<gp.length();++i)r.grips.push_back(gp[i]);gp.setLogicalLength(0);const auto status=e->getStretchPoints(gp);if(status==Acad::eOk)for(int i=0;i<gp.length();++i)r.stretch.push_back(gp[i]);return r;}
std::string d9_points(const std::vector<AcGePoint3d>& points){std::vector<std::string> rows;for(const auto& p:points)rows.push_back(point(p));return array(rows);}
std::string d9_level_state(AcDbObjectId id){Working scope(id.database());const auto r=d9_read_level(id);auto e=opened<AcDbEntity>(id);const auto& t=r.scene.texts[0];std::vector<std::string> lines;for(const auto& l:r.scene.lines)lines.push_back(object({{"start",point(l.first)},{"end",point(l.second)}}));return object({{"handle",handle(id)},{"owner",handle(e->ownerId())},{"class",text(e->isA()->name())},{"apex",point(r.apex)},{"caption",quote(r.caption)},{"metres",number(r.value)},{"lines",array(lines)},{"textPosition",point(t.position)},{"rotation",number(t.rotation)},{"height",number(t.height)},{"width",number(t.widthFactor)},{"mirroredX",truth(t.mirroredX)},{"mirroredY",truth(t.mirroredY)},{"layer",layer_record(e->layerId())},{"style",style_record(t.style)},{"grips",d9_points(r.grips)},{"stretch",d9_points(r.stretch)},{"coverage",quote(std::string("Actual public geometry/caption/font/grips only; unknown custom private fields remain partial"))}});}

struct D9Modern{AcDbEntity& e;AcDbGripDataPtrArray data;bool acquired{},cleaned{},safe=true;void cleanup()noexcept{if(!acquired||cleaned)return;cleaned=true;try{e.gripStatus(AcDb::kGripsToBeDeleted);}catch(...){safe=false;}std::set<const void*> points,wrappers;for(int i=0;i<data.length();++i)if(data[i]){auto* p=data[i]->alternateBasePoint();if(p&&points.insert(p).second)try{delete p;}catch(...){safe=false;}}for(int i=0;i<data.length();++i)if(data[i]&&wrappers.insert(data[i]).second)try{delete data[i];}catch(...){safe=false;}try{e.gripStatus(AcDb::kGripsDone);}catch(...){safe=false;}}~D9Modern(){cleanup();}};


bool d9_same_line(const std::pair<AcGePoint3d,AcGePoint3d>& a,const std::pair<AcGePoint3d,AcGePoint3d>& b){return(a.first.distanceTo(b.first)<tolerance&&a.second.distanceTo(b.second)<tolerance)||(a.first.distanceTo(b.second)<tolerance&&a.second.distanceTo(b.first)<tolerance);}
struct D9UpperBar{std::size_t index{};bool leftAtFirst{};AcGePoint3d left,right;};
D9UpperBar d9_actual_upper_bar(const D9LevelRead& state){std::vector<D9UpperBar> found;for(std::size_t i=0;i<state.scene.lines.size();++i){const auto& line=state.scene.lines[i];if(std::abs(line.first.y-line.second.y)<tolerance&&std::abs(line.first.y-state.apex.y-300)<tolerance&&std::abs(line.first.x-line.second.x)>600){const bool left=line.first.x<line.second.x;found.push_back({i,left,left?line.first:line.second,left?line.second:line.first});}}require(found.size()==1,"D9 back mark actual upper bar must be unique");return found.front();}
int d9_text_clearance_effect(const D9LevelRead& before,const D9LevelRead& after,double dx){if(before.caption!=after.caption||std::abs(before.value-after.value)>tolerance||before.apex.distanceTo(after.apex)>tolerance||before.scene.lines.size()!=4||after.scene.lines.size()!=4||before.scene.texts.size()!=1||after.scene.texts.size()!=1||before.grips.size()!=after.grips.size()||before.stretch.size()!=after.stretch.size())return 0;const auto& a=before.scene.texts[0];const auto& b=after.scene.texts[0];const AcGeVector3d delta(dx,0,0);if(a.text!=b.text||b.position.distanceTo(a.position+delta)>tolerance||std::abs(a.rotation-b.rotation)>tolerance||std::abs(a.height-b.height)>tolerance||std::abs(a.widthFactor-b.widthFactor)>tolerance||a.mirroredX!=b.mirroredX||a.mirroredY!=b.mirroredY||!compare_fields(resource_shape(a.style),resource_shape(b.style)).equal)return 0;const auto bar=d9_actual_upper_bar(before);for(int effect:{1,2}){auto expected=before.scene.lines;if(effect==2){if(bar.leftAtFirst)expected[bar.index].first+=delta;else expected[bar.index].second+=delta;}std::vector<bool> used(expected.size());bool shape=true;for(const auto& line:after.scene.lines){bool matched=false;for(std::size_t i=0;i<expected.size();++i)if(!used[i]&&d9_same_line(line,expected[i])){used[i]=true;matched=true;break;}shape=shape&&matched;}if(!shape)continue;auto expectedPoint=[&](const AcGePoint3d& pointValue){return pointValue.distanceTo(a.position)<tolerance||(effect==2&&pointValue.distanceTo(bar.left)<tolerance)?pointValue+delta:pointValue;};bool grips=true;for(std::size_t i=0;i<before.grips.size();++i)grips=grips&&after.grips[i].distanceTo(expectedPoint(before.grips[i]))<tolerance;for(std::size_t i=0;i<before.stretch.size();++i)grips=grips&&after.stretch[i].distanceTo(expectedPoint(before.stretch[i]))<tolerance;if(grips)return effect;}return 0;}
std::string d9_move_actual_text_grip(AcDbObjectId id,bool modern,bool barPoint,double dx){Working work(id.database());const auto before=d9_read_level(id);const auto from=barPoint?d9_actual_upper_bar(before).left:before.scene.texts[0].position;const AcGeVector3d delta(dx,0,0);auto entity=opened<AcDbEntity>(id,AcDb::kForWrite);int index=-1;Acad::ErrorStatus status=Acad::eInvalidInput;std::vector<std::string> returned;if(modern){resbuf screen{},height{},size{},view{};require(acedGetVar(L"SCREENSIZE",&screen)==RTNORM&&acedGetVar(L"VIEWSIZE",&height)==RTNORM&&acedGetVar(L"GRIPSIZE",&size)==RTNORM&&acedGetVar(L"VIEWDIR",&view)==RTNORM,"D9 actual text grip view parameters");require(height.restype==RTREAL&&height.resval.rreal>0&&size.restype==RTSHORT,"D9 actual text grip view types");const AcGeVector3d direction(view.resval.rpoint[0],view.resval.rpoint[1],view.resval.rpoint[2]);require(direction.z>0&&std::abs(direction.x)<tolerance&&std::abs(direction.y)<tolerance,"D9 top view for actual text grip");D9Modern owned{*entity};owned.acquired=true;check(entity->getGripPoints(owned.data,screen.resval.rpoint[1]/height.resval.rreal,size.resval.rint,direction,0),"D9 actual native text point grips");std::vector<int> matches;for(int i=0;i<owned.data.length();++i)if(owned.data[i]){returned.push_back(object({{"actualIndex",std::to_string(i)},{"point",point(owned.data[i]->gripPoint())},{"opaqueIdentity",quote(std::to_string(reinterpret_cast<std::uintptr_t>(owned.data[i]->appData())))}}));if(owned.data[i]->gripPoint().distanceTo(from)<tolerance&&owned.data[i]->appData())matches.push_back(i);}require(matches.size()==1,"D9 actual text/bar getter must uniquely match current opaque point");index=matches[0];AcDbVoidPtrArray selected;selected.append(owned.data[index]->appData());status=entity->moveGripPointsAt(selected,delta,0);owned.cleanup();require(owned.safe,"D9 native text grip cleanup failed");}else{std::vector<int> matches;for(std::size_t i=0;i<before.grips.size();++i){returned.push_back(object({{"actualIndex",std::to_string(i)},{"point",point(before.grips[i])}}));if(before.grips[i].distanceTo(from)<tolerance)matches.push_back(static_cast<int>(i));}require(matches.size()==1,"D9 actual text/bar getter must uniquely match returned legacy point");index=matches[0];AcDbIntArray selected;selected.append(index);status=entity->moveGripPointsAt(selected,delta);}check(status,"D9 move actual native text-related grip");return object({{"modern",truth(modern)},{"selectedGetter",quote(std::string(barPoint?"actual upper-bar left endpoint":"actual rendered AcDbText position"))},{"actualIndex",std::to_string(index)},{"actualReturnedPoints",array(returned)},{"actualSelectedSourcePoint",point(from)},{"requestedPoint",point(from+delta)},{"deltaX",number(dx)},{"status",std::to_string(status)}});}
std::string d9_move_datum_end(AcDbObjectId id,bool modern,double relativeEnd){Working work(id.database());const auto before=d9_read_level(id);const auto from=before.apex+AcGeVector3d(700,0,0),target=before.apex+AcGeVector3d(relativeEnd,0,0);auto entity=opened<AcDbEntity>(id,AcDb::kForWrite);int index=-1;Acad::ErrorStatus status=Acad::eInvalidInput;std::vector<std::string> returned;if(modern){resbuf screen{},height{},size{},view{};require(acedGetVar(L"SCREENSIZE",&screen)==RTNORM&&acedGetVar(L"VIEWSIZE",&height)==RTNORM&&acedGetVar(L"GRIPSIZE",&size)==RTNORM&&acedGetVar(L"VIEWDIR",&view)==RTNORM,"D9 actual modern datum view parameters");require(height.restype==RTREAL&&height.resval.rreal>0&&size.restype==RTSHORT,"D9 actual modern view types");const AcGeVector3d direction(view.resval.rpoint[0],view.resval.rpoint[1],view.resval.rpoint[2]);require(direction.z>0&&std::abs(direction.x)<tolerance&&std::abs(direction.y)<tolerance,"D9 top view for existing datum endpoint grip");D9Modern owned{*entity};owned.acquired=true;check(entity->getGripPoints(owned.data,screen.resval.rpoint[1]/height.resval.rreal,size.resval.rint,direction,0),"D9 actual current datum modern grips");std::vector<int> matches;for(int i=0;i<owned.data.length();++i)if(owned.data[i]){returned.push_back(object({{"actualIndex",std::to_string(i)},{"point",point(owned.data[i]->gripPoint())},{"opaqueIdentity",quote(std::to_string(reinterpret_cast<std::uintptr_t>(owned.data[i]->appData())))}}));if(owned.data[i]->gripPoint().distanceTo(from)<tolerance&&owned.data[i]->appData())matches.push_back(i);}require(matches.size()==1,"D9 existing native datum+700 must uniquely match actual opaque grip");index=matches[0];AcDbVoidPtrArray selected;selected.append(owned.data[index]->appData());status=entity->moveGripPointsAt(selected,target-from,0);owned.cleanup();require(owned.safe,"D9 existing modern datum grip cleanup failed");}else{std::vector<int> matches;for(std::size_t i=0;i<before.grips.size();++i){returned.push_back(object({{"actualIndex",std::to_string(i)},{"point",point(before.grips[i])}}));if(before.grips[i].distanceTo(from)<tolerance)matches.push_back(static_cast<int>(i));}require(matches.size()==1,"D9 existing native datum+700 must uniquely match actual legacy grip");index=matches[0];AcDbIntArray selected;selected.append(index);status=entity->moveGripPointsAt(selected,target-from);}check(status,"D9 move existing native datum endpoint only");return object({{"modern",truth(modern)},{"actualMatchedIndex",std::to_string(index)},{"actualReturnedPoints",array(returned)},{"sourceDatumEnd",point(from)},{"requestedDatumEnd",point(target)},{"status",std::to_string(status)}});}
bool d9_datum_post(const D9LevelRead& source,const D9LevelRead& after,double relativeEnd){if(after.caption!=source.caption||std::abs(after.value-source.value)>tolerance||after.apex.distanceTo(source.apex)>tolerance||source.scene.lines.size()!=4||after.scene.lines.size()!=4||source.scene.texts.size()!=1||after.scene.texts.size()!=1||source.grips.size()!=after.grips.size()||source.stretch.size()!=after.stretch.size())return false;const auto from=source.apex+AcGeVector3d(700,0,0),target=source.apex+AcGeVector3d(relativeEnd,0,0),left=source.apex+AcGeVector3d(-300,0,0);std::vector<std::pair<AcGePoint3d,AcGePoint3d>> expected=source.scene.lines;std::size_t count=0;for(auto& line:expected)if(d9_same_line(line,{from,left})){line={target,left};++count;}if(count!=1)return false;std::vector<bool> used(4);for(const auto& line:after.scene.lines){bool matched=false;for(std::size_t i=0;i<expected.size();++i)if(!used[i]&&d9_same_line(line,expected[i])){used[i]=true;matched=true;break;}if(!matched)return false;}for(std::size_t i=0;i<source.grips.size();++i)if(after.grips[i].distanceTo(source.grips[i].distanceTo(from)<tolerance?target:source.grips[i])>tolerance)return false;for(std::size_t i=0;i<source.stretch.size();++i)if(after.stretch[i].distanceTo(source.stretch[i].distanceTo(from)<tolerance?target:source.stretch[i])>tolerance)return false;const auto& a=source.scene.texts[0];const auto& b=after.scene.texts[0];return a.text==b.text&&a.position.distanceTo(b.position)<tolerance&&std::abs(a.rotation-b.rotation)<tolerance&&std::abs(a.height-b.height)<tolerance&&std::abs(a.widthFactor-b.widthFactor)<tolerance&&a.mirroredX==b.mirroredX&&a.mirroredY==b.mirroredY&&compare_fields(resource_shape(a.style),resource_shape(b.style)).equal;}
