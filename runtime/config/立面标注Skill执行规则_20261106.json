  "requirements": [
    {
      "id": "EA01",
      "topic": "范围与优先级",
      "requirement": "仅本插件立面标注；当前用户明确确认优先，同范围采用本Skill共用及立面规则。剖面继承共用标注不代表本插件启用剖面功能；平面与几何造型规则不连带改写。",
      "source": "common.md;section.md"
    },
    {
      "id": "EA02",
      "topic": "项目事实",
      "requirement": "读取当前单位、比例、实际外墙轴线、墙底、平面轴网、观察方向、零点、真实控制高度与字体资源；案例坐标/句柄/层高/数量不作为通用常数。",
      "source": "common.md;elevation.md"
    },
    {
      "id": "EA03",
      "topic": "尺度换算",
      "requirement": "建筑实际长度不随排版比例改变；布局采用纸面毫米，模型距离=纸面毫米×比例分母÷每绘图单位对应毫米数。标高数值以米表达。",
      "source": "common.md"
    },
    {
      "id": "EA04",
      "topic": "尺寸内容",
      "requirement": "底部仅轴间分段及总轴距两道，左右侧三道竖向主尺寸；底部第三道、同类局部上窗偏移链及屋顶上方两道水平尺寸不恢复，必要建筑内部净高保留。",
      "source": "elevation.md"
    },
    {
      "id": "EA05",
      "topic": "真实整体与连续",
      "requirement": "使用真正整体TDbDimension2；第二道底水平及侧竖向均连续，实际测点/测值/共享节点可编辑，分段和总量闭合。",
      "source": "common.md;elevation.md"
    },
    {
      "id": "EA06",
      "topic": "洞口及细碎尺寸",
      "requirement": "洞口按当前视向真实可见开口与控制点标注，不把相切或侧投窗框当正向洞口；檐口线脚120/250/150/180/480等细碎装饰尺寸暂不标，按构件用途识别，不按数值全图删除合法主链段。",
      "source": "elevation.md"
    },
    {
      "id": "EA07",
      "topic": "侧向五段",
      "requirement": "外墙轴线基准，向本侧建筑外侧1800/600/800/800/600；累计可见起笔1800、第三道2400、第二道3200、最外第一道4000、主标高尖4600（1:100模型毫米）。",
      "source": "elevation.md"
    },
    {
      "id": "EA08",
      "topic": "底部四段",
      "requirement": "真实墙底至可见起笔800、起笔至第二道1600、第二道至第一道800、第一道至轴圈圆心800；累计800/2400/3200/4000（1:100模型毫米）。",
      "source": "elevation.md"
    },
    {
      "id": "EA09",
      "topic": "量点定义",
      "requirement": "分别核对实际轴线、尺寸定义点、DIMEXO后的可见起笔端、真实基线、尾段和三角尖。底部量轴圈圆心，平面近边口径不套入立面。",
      "source": "common.md;elevation.md"
    },
    {
      "id": "EA10",
      "topic": "轴网来源",
      "requirement": "配套平面确认的同一逻辑轴按观察方向投影排序，不从立面外观猜轴或复制参考编号；转向不重建无关编号。",
      "source": "elevation.md"
    },
    {
      "id": "EA11",
      "topic": "轴号本体及引线",
      "requirement": "真正TDbAxisLabelSet，当前确认样式1:100圆半径400、文字正向；引线在两道尺寸处通过真实测站。偏移轴圈可用真实本体及独立可编辑折线，不让长斜线在错误轴位穿过尺寸行。",
      "source": "elevation.md"
    },
    {
      "id": "EA12",
      "topic": "控制线",
      "requirement": "DOTE／24，层 Continuous、对象 DOTE。横向控制线按实际地坪、楼层、檐口、屋脊及适用的屋面高度表达。竖向轴线按平面确认的左右外墙定位轴投影，与底部轴号和实际测站对齐。",
      "source": "elevation.md"
    },
    {
      "id": "EA13",
      "topic": "主标高双侧覆盖",
      "requirement": "按本项目真实室内外地坪、楼层、檐口、屋脊等建立立面×侧别×控制高度应有/实有清单，默认双侧；当前明确单侧例外逐项记录。",
      "source": "elevation.md EE01"
    },
    {
      "id": "EA14",
      "topic": "标高真实值",
      "requirement": "真正TDbSymbElevation，米制三位小数，零值±0.000；基于实际零点和构件测点，不仅改可见数字或复制其他项目高度。",
      "source": "elevation.md EE02"
    },
    {
      "id": "EA15",
      "topic": "标高姿态",
      "requirement": "常规空心倒三角、数字在上。实测符号或文字净距不足时，下方标高用空心向上三角、文字在基线下方，保持尖点、真实值、基线接点和原生类型。近邻较低室外标高沿用下翻。右侧文字正向。",
      "source": "elevation.md EE03"
    },
    {
      "id": "EA16",
      "topic": "主标高定位与基线",
      "requirement": "主尖点距本侧最外第一道竖向尺寸线向外600（1:100模型毫米）。原生基线向内接本侧第二道竖向尺寸基线的同高测站。主尖点到接点在标准排布下为1400。",
      "source": "elevation.md EE04"
    },
    {
      "id": "EA17",
      "topic": "局部标高及去重",
      "requirement": "屋面/门廊/平台锚真实构件测点就近避让；允许的文字和上横线调整保持尖点/高度/数值。基线长度按实际需要，不固定700；局部同表达去重不删除另一侧应有主标高。",
      "source": "elevation.md EE05"
    },
    {
      "id": "EA18",
      "topic": "图名",
      "requirement": "真正TDbDrawingName，DIM_SYMB3、内部字7；当前项目方向/名称/比例，与轴圈冲突采用整体排布调整。",
      "source": "elevation.md"
    },
    {
      "id": "EA19",
      "topic": "有效文字外观",
      "requirement": "尺寸/轴号/标高/图名内部有效字色7，与真实对象保持编辑关系；外根归3色层不把内部字全改成层色。尺寸/标高使用参考真实字体，名义字高/实际字形高/比例分别核对。",
      "source": "elevation.md"
    },
    {
      "id": "EA20",
      "topic": "参考字体边界",
      "requirement": "SIMPLEX+GBCBIG、模型字形高297.5及宽0.7058823529411765属于D8参考原型；2.975纸面代码字段不等于批准所有文字字高。平面FY_HZ及门窗号纸面3.0不自动套立面全部文字。",
      "source": "common.md;elevation.md"
    },
    {
      "id": "EA21",
      "topic": "层色及线宽",
      "requirement": "立面标注按AXIS3/PUB_DIM25/DIM_ELEV3/DOTE24/DIM_SYMB3/DIM_LEAD3/DIM_IDEN1。立面说明及附表按需用PUB_TEXT7/PUB_TAB3/A-TEXT-DESC4。层线型Continuous，线宽Default。控制线对象指定DOTE，索引辅助线按实际用途核对__DASH。读取块内与天正派生最终外观，实际打印线宽按CTB/STB及出图设置核验。",
      "source": "elevation.md"
    },
    {
      "id": "EA22",
      "topic": "避让与排版",
      "requirement": "通过真实文字夹点、基线或整体排布避让，不改真实测值/字体伪装通过；核实际字框及窗梃/烟囱/基线，补齐后重算全部标注外包及出图窗口。",
      "source": "elevation.md"
    },
    {
      "id": "EA23",
      "topic": "保存重开及覆盖验收",
      "requirement": "修改DWG后保存重开，逐立面逐侧逐控制高度唯一匹配实际对象并看两端；列缺失/重复/错值/错位/反字/裁切。原对象和总数保持、CAD审计或API成功不替代完整性及最终图面。",
      "source": "common.md;elevation.md"
    },
    {
      "id": "EA24",
      "topic": "状态与待补项",
