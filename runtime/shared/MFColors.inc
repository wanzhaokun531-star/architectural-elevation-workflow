AcDbObjectId d7_pub_layer(AcDbDatabase& db){Working work(&db);auto table=opened<AcDbLayerTable>(db.layerTableId());AcDbObjectId id;if(table->has(L"PUB DIM")){check(table->getAt(L"PUB DIM",id),"D7 get exact space layer");auto layer=opened<AcDbLayerTableRecord>(id);require(layer->color().colorIndex()==25&&!layer->isOff()&&!layer->isFrozen()&&layer->isPlottable(),"D7 existing PUB DIM conflicts with required25 visible printable definition; shared layer was not edited");return id;}table.reset();auto target=opened<AcDbLayerTable>(db.layerTableId(),AcDb::kForWrite);auto fresh=std::make_unique<AcDbLayerTableRecord>();check(fresh->setName(L"PUB DIM"),"D7 exact user space layer name");AcCmColor color;color.setColorIndex(25);fresh->setColor(color);check(fresh->setIsPlottable(true),"D7 new layer printable");check(target->add(id,fresh.get()),"D7 add dedicated PUB DIM without changing PUB_DIM");auto* stored=fresh.release();check(stored->close(),"D7 close new dedicated layer");return id;}
int d7_effective_color(const AcCmColor& color,AcDbObjectId layerId,int inherited){const int index=color.colorIndex();if(index==0)return inherited;if(index==256){auto layer=opened<AcDbLayerTableRecord>(layerId);return layer->color().colorIndex();}return index;}
struct D7ColorSegment{AcGePoint3d first,second;std::wstring layer;int line{},extension{},textColor{};};
struct D7Colors{std::wstring layer;int rootIndex{},rootEffective{};std::vector<D7ColorSegment> segments;std::string json;};
D7Colors d7_read_dimension_colors(AcDbObjectId id,ObservationLog& log){Working work(id.database());auto root=opened<AcDbEntity>(id);AcString rootName;check(root->layer(rootName),"D7 actual root layer");D7Colors result;result.layer=rootName.kACharPtr();result.rootIndex=root->colorIndex();result.rootEffective=d7_effective_color(root->color(),root->layerId(),0);Exploded exploded;const auto status=root->explode(exploded.values);require(capture_returns(exploded,root.get(),log),"D7 readonly derived dimension color ownership unresolved");check(status,"D7 actual derived dimension color explode");std::vector<std::string> rows;for(const auto* entity:exploded.accepted){const auto* segment=AcDbAlignedDimension::cast(entity);require(segment,"D7 actual segment color must be native aligned dimension");AcString layer;check(segment->layer(layer),"D7 actual derived dimension layer");const int entityColor=d7_effective_color(segment->color(),segment->layerId(),result.rootEffective),line=d7_effective_color(segment->dimclrd(),segment->layerId(),entityColor),extension=d7_effective_color(segment->dimclre(),segment->layerId(),entityColor),textColor=d7_effective_color(segment->dimclrt(),segment->layerId(),entityColor);result.segments.push_back({segment->xLine1Point(),segment->xLine2Point(),layer.kACharPtr(),line,extension,textColor});rows.push_back(object({{"first",point(segment->xLine1Point())},{"second",point(segment->xLine2Point())},{"actualLayer",text(layer.kACharPtr())},{"segmentColorIndex",std::to_string(segment->colorIndex())},{"dimclrd",std::to_string(segment->dimclrd().colorIndex())},{"dimclre",std::to_string(segment->dimclre().colorIndex())},{"dimclrt",std::to_string(segment->dimclrt().colorIndex())},{"effectiveDimensionLineACI",std::to_string(line)},{"effectiveExtensionACI",std::to_string(extension)},{"effectiveTextACI",std::to_string(textColor)}}));}result.json=object({{"rootLayer",text(rootName.kACharPtr())},{"rootColorIndex",std::to_string(result.rootIndex)},{"rootEffectiveACI",std::to_string(result.rootEffective)},{"publicDerivedSegments",array(rows)},{"coverage",quote(std::string("Actual exploded TCH segment layer and public effective dimension/extension/text color getters; text retains actual source color independently of line/extension layer color"))}});return result;}
void d7_validate_dimension_colors(const D7Colors& actual,const std::wstring& intended,const D7Colors* before=nullptr){require(actual.rootIndex==256,"D7 dimension root must be ByLayer");require(actual.layer==intended,"D7 actual root layer differs from explicit intent");if(intended==L"PUB DIM")require(actual.rootEffective==25,"D7 new PUB DIM root effective color not25");if(before)require(before->segments.size()==actual.segments.size(),"D7 dimension source/after color segment count changed");for(const auto& segment:actual.segments){require(segment.layer==intended,"D7 actual derived dimension did not adopt root layer");require(segment.line==actual.rootEffective&&segment.extension==actual.rootEffective,"D7 derived line/extension effective colors did not follow intended layer");if(before){const D7ColorSegment* matched=nullptr;for(const auto& previous:before->segments)if((previous.first.distanceTo(segment.first)<tolerance&&previous.second.distanceTo(segment.second)<tolerance)||(previous.first.distanceTo(segment.second)<tolerance&&previous.second.distanceTo(segment.first)<tolerance)){require(!matched,"D7 source text color segment match ambiguous");matched=&previous;}require(matched&&matched->textColor==segment.textColor,"D7 actual source text effective color was not retained");}}}
std::string d7_dimension_colors(AcDbObjectId id,const std::wstring& intended,ObservationLog& log,const wchar_t* phase){const auto actual=d7_read_dimension_colors(id,log);wchar_t h[32]{};id.handle().getIntoAsciiBuffer(h);report_file(log.config,L"d7-dimension-color-check-"+std::wstring(phase)+L"-"+std::wstring(h)+L".json",actual.json);d7_validate_dimension_colors(actual,intended);return actual.json;}
