 report_file(config,diagnostic,object({{"sourceNewAxis",handle(id)},{"before",json(before)},{"expected",json(expected)},{"originalNativeLines",native_lines(originalScene)},{"actualTarget",point(target)},{"candidateAccepted",truth(accepted!=nullptr)},{"numericTolerance",number(eps)},{"attempts",array(attempts)},{"failureIsolation",quote(std::string("Every attempt uses a fresh owned scratch database and wblock clone; no abort rollback assumed"))}}));
 require(!isolationError,"D4 isolated trial changed original added donor; see recorded attempts");require(accepted!=nullptr,"D4 no isolated public modern-grip candidate satisfies unchanged-circle and full native geometry contract");const auto result=clone_material(*accepted,db,acceptedId);require(same(readGeometry(result),expected)&&scene_matches(originalScene,axis_scene(result),old,target),"D4 accepted scratch candidate clone changed actual geometry");{auto unused=opened<AcDbEntity>(id,AcDb::kForWrite);check(unused->erase(),"D4 erase only this newly added unadapted donor root");}return result;
