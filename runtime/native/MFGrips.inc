}
AcDbObjectId endpoint(AcDbDatabase& db,AcDbObjectId id,const AcGePoint3d& old,const AcGePoint3d& target,const Config& config,const std::wstring& diagnostic){
 Working sourceScope(&db);const auto before=readGeometry(id);const auto originalScene=axis_scene(id);auto expected=before;std::size_t anchor=0;int grips=0,stretch=0;for(std::size_t i=0;i<expected.grips.size();++i)if(expected.grips[i].distanceTo(old)<eps){anchor=i;expected.grips[i]=target;++grips;}for(auto& p:expected.stretch)if(p.distanceTo(old)<eps){p=target;++stretch;}require(grips==1&&stretch==1&&anchor%4==0,"D4 unique actual lead endpoint");const auto v=view();int count=1;std::vector<std::string> attempts;std::unique_ptr<AcDbDatabase> accepted;AcDbObjectId acceptedId;bool isolationError=false;
