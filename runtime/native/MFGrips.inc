};

std::string native_lines(const AxisScene& scene){std::vector<std::string> rows;for(const auto& l:scene.lines)rows.push_back(object({{"start",point(l.first)},{"end",point(l.second)}}));return array(rows);}
bool scene_matches(const AxisScene& before,const AxisScene& after,const AcGePoint3d& old,const AcGePoint3d& target){
 if(!after.visible||before.circles.size()!=after.circles.size()||before.texts.size()!=after.texts.size()||before.lines.size()!=after.lines.size())return false;
 for(std::size_t i=0;i<before.circles.size();++i)if(before.circles[i].first.distanceTo(after.circles[i].first)>eps||std::abs(before.circles[i].second-after.circles[i].second)>eps)return false;
 for(std::size_t i=0;i<before.texts.size();++i){const auto& a=before.texts[i];const auto& b=after.texts[i];if(a.text!=b.text||a.position.distanceTo(b.position)>eps||std::abs(a.rotation-b.rotation)>eps||std::abs(a.height-b.height)>eps||std::abs(a.widthFactor-b.widthFactor)>eps||symbol_name(a.style)!=symbol_name(b.style))return false;}
 for(std::size_t i=0;i<before.lines.size();++i){const auto a=before.lines[i].first.distanceTo(old)<eps?target:before.lines[i].first;const auto b=before.lines[i].second.distanceTo(old)<eps?target:before.lines[i].second;if(a.distanceTo(after.lines[i].first)>eps||b.distanceTo(after.lines[i].second)>eps)return false;}
 return true;
}
struct MoveReadback{int status=-1,count{};bool hasData{};std::string modern="[]";AcGeVector3d delta;};
MoveReadback move(AcDbEntity& e,int index,const AcGeVector3d& offset,const AcGePoint3d* target,const View& v){
 MoveReadback out;Grips owned(e);owned.acquired=true;check(e.getGripPoints(owned.data,v.pixelsPerUnit,v.size,v.direction,0),"D4 scratch modern getGripPoints");out.count=owned.data.length();require(out.count>0&&out.count<=64,"D4 scratch modern grip count bound");std::vector<std::string> rows;for(int i=0;i<owned.data.length();++i){if(!owned.data[i]){rows.push_back("null");continue;}rows.push_back(object({{"index",std::to_string(i)},{"point",point(owned.data[i]->gripPoint())},{"hasOpaqueAppData",truth(owned.data[i]->appData()!=nullptr)}}));}out.modern=array(rows);
 if(index<out.count&&owned.data[index]&&owned.data[index]->appData()){out.hasData=true;out.delta=target?*target-owned.data[index]->gripPoint():offset;void* const identity=owned.data[index]->appData();AcDbVoidPtrArray selected;selected.append(identity);out.status=static_cast<int>(e.moveGripPointsAt(selected,out.delta,0));}owned.cleanup();require(owned.safe,"D4 scratch modern wrapper lifetime cleanup");return out;
}
struct Attempt{std::unique_ptr<AcDbDatabase> scratch;AcDbObjectId axis;Geometry after;int count=1;bool innerMatched{},matched{};std::string json;};
Attempt apply(AcDbDatabase& source,AcDbObjectId seed,int index,int second,std::size_t anchor,const Geometry& before,const Geometry& expected,const AxisScene& originalScene,const AcGePoint3d& old,const AcGePoint3d& target,const View& v,const AcGeVector3d& calibration){
 Attempt out;std::string error,firstModern="[]",secondModern="[]",firstAfter="null",nativeAfter="null";int firstStatus=-1,secondStatus=-1;bool firstHasData=false,secondHasData=false;AcGeVector3d firstDelta,secondDelta;
 try{out.scratch=std::make_unique<AcDbDatabase>(true,true);out.axis=clone_material(source,*out.scratch,seed);Working scope(out.scratch.get());require(same(readGeometry(out.axis),before),"D4 new isolated trial clone changed source geometry");{auto e=opened<AcDbEntity>(out.axis,AcDb::kForWrite);const auto requested=expected.grips[anchor]+calibration;const auto first=move(*e,index,AcGeVector3d(0,0,0),&requested,v);firstStatus=first.status;out.count=first.count;firstHasData=first.hasData;firstModern=first.modern;firstDelta=first.delta;}
  out.after=readGeometry(out.axis);firstAfter=json(out.after);out.innerMatched=firstStatus==0&&out.after.grips.size()==before.grips.size()&&out.after.grips[anchor].distanceTo(expected.grips[anchor])<eps;
  if(out.innerMatched&&!same(out.after,expected)&&second>=0){const auto restore=before.grips[anchor+1]-out.after.grips[anchor+1];auto e=opened<AcDbEntity>(out.axis,AcDb::kForWrite);const auto next=move(*e,second,restore,nullptr,v);secondStatus=next.status;secondHasData=next.hasData;secondModern=next.modern;secondDelta=next.delta;e.reset();out.after=readGeometry(out.axis);}
  const auto actualScene=axis_scene(out.axis);nativeAfter=native_lines(actualScene);out.matched=firstStatus==0&&(second<0||secondStatus==0)&&same(out.after,expected)&&scene_matches(originalScene,actualScene,old,target);
 }catch(const std::exception& ex){error=ex.what();}
 out.json=object({{"actualIndex",std::to_string(index)},{"secondIndex",std::to_string(second)},{"before",json(before)},{"expected",json(expected)},{"target",point(target)},{"calibration",point(AcGePoint3d::kOrigin+calibration)},{"firstModernGrips",firstModern},{"firstHasOpaqueAppData",truth(firstHasData)},{"firstStatus",std::to_string(firstStatus)},{"firstDelta",point(AcGePoint3d::kOrigin+firstDelta)},{"firstAfter",firstAfter},{"secondModernGrips",secondModern},{"secondHasOpaqueAppData",truth(secondHasData)},{"secondStatus",std::to_string(secondStatus)},{"secondDelta",point(AcGePoint3d::kOrigin+secondDelta)},{"after",json(out.after)},{"actualNativeLinesAfter",nativeAfter},{"innerMatched",truth(out.innerMatched)},{"allPostconditionsMatched",truth(out.matched)},{"error",quote(error)},{"transactionAbortUsed","false"}});
